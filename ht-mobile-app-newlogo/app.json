{
  "expo": {
    "name": "HT Polrestabes",
    "slug": "ht-peminjaman",
    "scheme": "htpeminjaman",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.polresta.htpeminjaman",
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikasi membutuhkan akses kamera untuk memindai QR Code unit HT.",
        "NSPhotoLibraryUsageDescription": "Aplikasi membutuhkan akses galeri foto untuk memilih foto profil personel.",
        "NSPhotoLibraryAddUsageDescription": "Aplikasi membutuhkan izin untuk menyimpan dokumen bukti dan slip kredensial."
      }
    },
    "android": {
      "package": "com.polresta.htpeminjaman",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B132B"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi membutuhkan akses kamera untuk memindai QR Code unit HT.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi membutuhkan akses galeri untuk memilih dan mengunggah foto profil personel."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0454035-7e4b-4eff-86a3-534496f71905"
      }
    }
  }
}
